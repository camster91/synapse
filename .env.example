# Required application configuration
DATABASE_URL="postgresql://synapse:synapse@localhost:5432/synapse?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-value"
# Exactly 32 UTF-8 characters. Do not rotate without a key-migration plan.
SYNAPSE_ENCRYPTION_KEY="replace-with-32-utf8-characters"
# Set true only behind a trusted proxy that overwrites client-IP headers.
TRUST_PROXY="false"
# Immutable commit or image revision shown by health checks and structured logs.
RELEASE_REV="development"

# Transactional authentication email. Configure only with an approved sender/domain.
# The current external adapter supports Resend through its HTTPS API.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Synapse <no-reply@example.com>"
EMAIL_REPLY_TO=""
# Optional if authentication links should use a different public origin than NEXTAUTH_URL.
AUTH_PUBLIC_URL=""
# Disposable #29 loopback smoke only; never use on a beta/public hostname.
# EMAIL_PROVIDER="local-sink"
# AUTH_EMAIL_LOCAL_SINK="disposable-lifecycle-only"
AUTH_EMAIL_LOCAL_SINK=""

# Optional server-level AI fallback. Beta users may instead connect their own encrypted keys.
DEFAULT_AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Production database settings used by docker-compose.prod.yml
POSTGRES_USER="synapse"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="synapse"
